{
  "name": "@chen_hu_hu/pi-qq",
  "version": "1.2.3",
  "description": "Connect pi to QQ private chats.",
  "license": "MIT",
  "author": "CQ-Developer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CQ-Developer/pi-qq.git"
  },
  "homepage": "https://github.com/CQ-Developer/pi-qq#readme",
  "bugs": {
    "url": "https://github.com/CQ-Developer/pi-qq/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "qq",
    "qqbot",
    "c2c",
    "tencent"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "doc",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npx --node-options=\"--experimental-strip-types\" eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "npx --node-options=\"--experimental-strip-types\" eslint --flag unstable_native_nodejs_ts_config . --fix",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "^1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
